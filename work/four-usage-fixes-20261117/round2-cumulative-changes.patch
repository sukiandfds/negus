+  assert.equal(calls, 2); assert.equal(resource.getSnapshot().data, previous);
+  await new Promise(resolve => setTimeout(resolve, 30)); assert.equal(calls, 2);
+  globalThis.fetch = async () => { calls++; return success('next-event'); };
